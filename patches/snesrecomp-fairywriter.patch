diff --git a/runner/src/snes/xband_keyboard.c b/runner/src/snes/xband_keyboard.c
new file mode 100644
index 0000000..bdf3815
--- /dev/null
+++ b/runner/src/snes/xband_keyboard.c
@@ -0,0 +1,75 @@
+#include "xband_keyboard.h"
+
+#include <string.h>
+
+static bool queue_byte(XbandKeyboard *keyboard, uint8_t value) {
+  if (keyboard->queue_count == kXbandKeyboardQueueCapacity)
+    return false;
+  uint8_t write = (uint8_t)((keyboard->queue_read + keyboard->queue_count) %
+                            kXbandKeyboardQueueCapacity);
+  keyboard->queue[write] = value;
+  keyboard->queue_count++;
+  return true;
+}
+
+void xband_keyboard_reset(XbandKeyboard *keyboard) {
+  memset(keyboard, 0, sizeof(*keyboard));
+  keyboard->io_high = true;
+}
+
+bool xband_keyboard_push_scancode(XbandKeyboard *keyboard, uint8_t scancode,
+                                  bool pressed, bool extended) {
+  unsigned needed = 1u + (extended ? 1u : 0u) + (pressed ? 0u : 1u);
+  if ((unsigned)keyboard->queue_count + needed > kXbandKeyboardQueueCapacity)
+    return false;
+  if (extended)
+    queue_byte(keyboard, 0xe0);
+  if (!pressed)
+    queue_byte(keyboard, 0xf0);
+  queue_byte(keyboard, scancode);
+  return true;
+}
+
+static void begin_transaction(XbandKeyboard *keyboard) {
+  keyboard->packet_count = keyboard->queue_count < 15 ? keyboard->queue_count : 15;
+  keyboard->bit_index = 0;
+  keyboard->transaction_active = true;
+  for (uint8_t i = 0; i < keyboard->packet_count; i++) {
+    keyboard->packet[i] = keyboard->queue[keyboard->queue_read];
+    keyboard->queue_read = (uint8_t)((keyboard->queue_read + 1) %
+                                     kXbandKeyboardQueueCapacity);
+    keyboard->queue_count--;
+  }
+}
+
+void xband_keyboard_write_io(XbandKeyboard *keyboard, uint8_t wrio) {
+  bool high = (wrio & 0x80) != 0;
+  if (!high)
+    begin_transaction(keyboard);
+  keyboard->io_high = high;
+}
+
+static uint8_t transaction_bit(const XbandKeyboard *keyboard, unsigned bit) {
+  if (bit < 8)
+    return (uint8_t)((0x78u >> bit) & 1u);
+  if (bit < 12)
+    return (uint8_t)((keyboard->packet_count >> (bit - 8)) & 1u);
+  bit -= 12;
+  if (bit >= (unsigned)keyboard->packet_count * 8u)
+    return 1;
+  return (uint8_t)((keyboard->packet[bit >> 3] >> (bit & 7)) & 1u);
+}
+
+uint8_t xband_keyboard_read_port(XbandKeyboard *keyboard) {
+  if (!keyboard->transaction_active)
+    return 0x03;
+  unsigned total_bits = 12u + (unsigned)keyboard->packet_count * 8u;
+  uint8_t pair = (uint8_t)(transaction_bit(keyboard, keyboard->bit_index) |
+                           (transaction_bit(keyboard, keyboard->bit_index + 1) << 1));
+  keyboard->bit_index = (uint8_t)(keyboard->bit_index + 2);
+  if (keyboard->bit_index >= total_bits)
+    keyboard->transaction_active = false;
+  // The keyboard's DATA0/DATA1 lines are active-low. The cartridge reader
+  // inverts the completed ID/count/scancode value, matching the XBAND BIOS.
+  return (uint8_t)(pair ^ 0x03u);
+}
diff --git a/runner/src/snes/xband_keyboard.h b/runner/src/snes/xband_keyboard.h
new file mode 100644
index 0000000..a8ee8fd
--- /dev/null
+++ b/runner/src/snes/xband_keyboard.h
@@ -0,0 +1,26 @@
+#ifndef SNES_XBAND_KEYBOARD_H
+#define SNES_XBAND_KEYBOARD_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum { kXbandKeyboardQueueCapacity = 256 };
+
+typedef struct XbandKeyboard {
+  uint8_t queue[kXbandKeyboardQueueCapacity];
+  uint16_t queue_read;
+  uint16_t queue_count;
+  uint8_t packet[15];
+  uint8_t packet_count;
+  uint8_t bit_index;
+  bool io_high;
+  bool transaction_active;
+} XbandKeyboard;
+
+void xband_keyboard_reset(XbandKeyboard *keyboard);
+bool xband_keyboard_push_scancode(XbandKeyboard *keyboard, uint8_t scancode,
+                                  bool pressed, bool extended);
+void xband_keyboard_write_io(XbandKeyboard *keyboard, uint8_t wrio);
+uint8_t xband_keyboard_read_port(XbandKeyboard *keyboard);
+
+#endif
