+static int16_t mouse_add_clamped(int16_t value, int8_t delta) {
+  int16_t result = (int16_t)(value + delta);
+  if (result > 127) return 127;
+  if (result < -127) return -127;
+  return result;
+}
+
+static uint8_t mouse_sign_magnitude(int16_t value) {
+  if (value < 0) return (uint8_t)(0x80 | (uint8_t)-value);
+  return (uint8_t)value;
+}
+
+static void snes_mouse_reset(SnesMouse *mouse) {
+  memset(mouse, 0, sizeof(*mouse));
+}
+
+static void snes_mouse_latch(SnesMouse *mouse, bool strobe) {
+  /* The report is captured on the high-to-low latch transition. The 32 bits
+   * are: zero, button/signature/sensitivity, signed Y, signed X. */
+  if (mouse->strobe && !strobe) {
+    const uint8_t buttons = (uint8_t)(0x01 | (mouse->left ? 0x40 : 0) |
+                                      (mouse->right ? 0x80 : 0));
+    mouse->report = ((uint32_t)buttons << 16) |
+                    ((uint32_t)mouse_sign_magnitude(mouse->dy) << 8) |
+                    mouse_sign_magnitude(mouse->dx);
+    mouse->dx = 0;
+    mouse->dy = 0;
+    mouse->bit = 0;
+  }
+  mouse->strobe = strobe;
+}
+
+static uint8_t snes_mouse_read_port(SnesMouse *mouse) {
+  if (mouse->bit >= 32) return 1;
+  const uint8_t value = (uint8_t)((mouse->report >> (31 - mouse->bit)) & 1u);
+  mouse->bit++;
+  return value;
+}
