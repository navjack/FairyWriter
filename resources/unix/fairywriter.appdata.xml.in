<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.navjack.FairyWriter</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>FairyWriter</name>
  <summary>Source-generated SNES cartridge word processor</summary>
  <description>
    <p>FairyWriter runs a real, source-generated Super Nintendo word-processor cartridge inside a native desktop application.</p>
    <p>The cartridge owns the fixed 256x224 editor, menus, help, keyboard, and mouse behavior. The native host owns documents, files, atomic saves, recovery, and operating-system integration.</p>
    <p>FairyWriter is experimental pre-release software derived from FocusWriter 1.9.0.</p>
  </description>

  <url type="homepage">https://github.com/navjack/FairyWriter</url>
  <url type="bugtracker">https://github.com/navjack/FairyWriter/issues</url>
  <url type="vcs-browser">https://github.com/navjack/FairyWriter</url>

  <developer id="io.github.navjack">
    <name translatable="no">FairyWriter contributors</name>
  </developer>

  <provides>
    <binary>fairywriter</binary>
    <mediatype>application/rtf</mediatype>
    <mediatype>application/vnd.oasis.opendocument.text</mediatype>
    <mediatype>application/vnd.oasis.opendocument.text-flat-xml</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.document</mediatype>
    <mediatype>text/plain</mediatype>
    <mediatype>text/rtf</mediatype>
  </provides>
  <launchable type="desktop-id">fairywriter.desktop</launchable>

  <kudos>
    <kudo>HiDpiIcon</kudo>
    <kudo>ModernToolkit</kudo>
  </kudos>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.3.6" date="2026-08-01">
      <description>
        <p>Pasting a long passage works. Anything past about 8 KB was silently dropped before it reached the document.</p>
        <p>Adds borderless full screen on F11, and a pickable colour for the area around the screen, defaulting to a pastel green.</p>
        <p>Hides the desktop mouse pointer over the screen, where FairyWriter draws its own, and fixes the settings cursor jumping to the top row on every change.</p>
      </description>
    </release>
    <release version="0.3.5" date="2026-07-31">
      <description>
        <p>Typing no longer makes the page flicker: styling, proofing marks and the selection now hold through every keystroke.</p>
        <p>Fixes Delete removing the wrong character, and selections that reached past the last character not highlighting at all.</p>
        <p>Runs the emulated machine at its true 60.0988 Hz, and drops the retired Qt desktop UI from the source tree.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-07-30">
      <description>
        <p>Typing now makes a sound. The cartridge uploads an SPC700 driver to the audio processor and every blip is the real S-DSP keying a voice.</p>
        <p>Adds a typing-sound editor on F5: waveform, ADSR envelope, pitch, volume, and the echo unit, each mapped to a hardware register.</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-07-29">
      <description>
        <p>Bold, italic and underline now render independently in every combination, and paragraph alignment is applied per visual line.</p>
        <p>Fixes opening a document from any file-browser row but the first.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-07-29">
      <description>
        <p>Initial public-development baseline for the cartridge-owned FairyWriter product.</p>
      </description>
    </release>
  </releases>
</component>
